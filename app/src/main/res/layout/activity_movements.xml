<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movimientos de inventario"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registra entradas y salidas con stock actualizado." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="SKU o código de barras"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSku"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanMovementBarcode"
                    style="@style/Widget.SQLite.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Escanear código de barras"
                    android:layout_marginTop="4dp"
                    app:cornerRadius="15dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckStock"
                    style="@style/Widget.SQLite.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Consultar stock"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="15dp" />

                <TextView
                    android:id="@+id/tvStockInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingresa un SKU o código de barras y consulta las existencias."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_info" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cantidad"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Motivo de salida / observación"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMovementNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Proveedor (opcional)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:paddingTop="12dp" />

                <Spinner
                    android:id="@+id/spinnerProvider"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEntry"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Registrar entrada"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="15dp"
                    app:backgroundTint="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExit"
                    style="@style/Widget.SQLite.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Registrar salida"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="15dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
