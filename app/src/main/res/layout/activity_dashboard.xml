<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_light" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeWidth="0dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BODEGA  /  CONTROL DE INVENTARIO" android:textColor="#D5ECE5" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Panel de trabajo" android:textColor="@color/white" android:textSize="25sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E3F0EC" android:textSize="15sp" android:paddingTop="5dp" />
    <View android:layout_width="42dp" android:layout_height="3dp" android:layout_marginTop="18dp" android:background="@color/accent" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="22dp" app:cardElevation="2dp" app:strokeColor="@color/border_soft" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Operación" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Accede a las tareas principales de bodega." android:textColor="@color/text_secondary" android:textSize="13sp" android:paddingTop="3dp" android:paddingBottom="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnInventory" android:layout_width="match_parent" android:layout_height="54dp" android:text="Productos e inventario" android:textAlignment="viewStart" android:textSize="15sp" app:cornerRadius="15dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnMovements" android:layout_width="match_parent" android:layout_height="54dp" android:text="Entradas y salidas" android:textAlignment="viewStart" android:textSize="15sp" android:layout_marginTop="8dp" app:cornerRadius="15dp" app:backgroundTint="@color/teal_soft" android:textColor="@color/primary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnStockReport" style="@style/Widget.SQLite.Button.Outlined" android:layout_width="match_parent" android:layout_height="50dp" android:text="Informe de stock" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="12dp" app:cornerRadius="15dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnMovementHistory" style="@style/Widget.SQLite.Button.Outlined" android:layout_width="match_parent" android:layout_height="50dp" android:text="Historial de movimientos" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="7dp" app:cornerRadius="15dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCategories" style="@style/Widget.SQLite.Button.Outlined" android:layout_width="match_parent" android:layout_height="50dp" android:text="Consultar categorías" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="7dp" app:cornerRadius="15dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLocation" style="@style/Widget.SQLite.Button.Outlined" android:layout_width="match_parent" android:layout_height="50dp" android:text="Ubicación del local" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="7dp" app:cornerRadius="15dp" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="22dp" app:cardElevation="2dp" app:strokeColor="@color/border_soft" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cuenta" android:textColor="@color/primary" android:textSize="17sp" android:textStyle="bold" android:paddingBottom="6dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnAdmin" android:layout_width="match_parent" android:layout_height="50dp" android:text="Administración" android:textAlignment="viewStart" android:textSize="14sp" android:layout_marginTop="2dp" app:cornerRadius="14dp" app:backgroundTint="@color/accent_soft" android:textColor="@color/primary_dark" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" style="@style/Widget.SQLite.Button.Text" android:layout_width="match_parent" android:layout_height="52dp" android:text="Cerrar sesión" android:textColor="@color/btn_delete" android:layout_marginTop="4dp" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTROL CLARO · INVENTARIO AL DÍA" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.08" android:paddingTop="18dp" android:paddingBottom="8dp" />
 </LinearLayout>
</ScrollView>
